<!DOCTYPE html>
<html>
<head>
<title>Billionaire Bio Science Codes</title>
<style>
body {background: black; color: #00ff88; text-align: center; font-family: Arial; padding: 20px;}
h1 {color: #00ff88; font-size: 28px;}
.upload-box {border: 2px dashed #00ff88; padding: 20px; margin: 20px auto; border-radius: 10px; max-width: 400px;}
img {width: 90%; max-width: 500px; margin: 10px; border: 2px solid #00ff88; border-radius: 10px;}
input[type="file"] {color: #00ff88;}
</style>
</head>
<body>

<h1>Billionaire Bio Science Codes</h1>

<div class="upload-box">
  <h3>تصویر Upload کریں</h3>
  <input type="file" id="upload" accept="image/*">
</div>

<div id="gallery"></div>

<script>
document.getElementById('upload').onchange = function(e) {
  let file = e.target.files[0];
  let reader = new FileReader();
  reader.onload = function(event) {
    let img = document.createElement('img');
    img.src = event.target.result;
    document.getElementById('gallery').prepend(img);
  }
  reader.readAsDataURL(file);
}
</script>

</body>
</html>